# Telegram Bot API. Заполните значения перед запуском.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ID администратора в Telegram (если TELEGRAM_CHAT_ID — группа, команды принимаются только от него)
TELEGRAM_ADMIN_ID=

# Параметры WheelsParser (пустое значение = значение по умолчанию)
CHECK_INTERVAL=
REQUEST_TIMEOUT=
MESSAGES_PER_CHANNEL=
# Сколько каналов опрашивается одновременно.
CHANNEL_FETCH_CONCURRENCY=
# Тайм-аут запроса страницы канала, сек: непрочитанный канал не теряется,
# его страница будет перечитана в следующем цикле.
CHANNEL_FETCH_TIMEOUT=
MAX_SEEN_PER_CHANNEL=
# Максимум записей истории в wheels.db — старые отбрасываются.
MAX_RESULTS=
WHEELS_WINDOW_MINUTES=
# Период /top (рейтинг каналов по числу колёс) по умолчанию, дней.
TOP_PERIOD_DAYS=
ACTIVE_MAX_AGE_HOURS=
ACTIVE_CHECK_CONCURRENCY=
REALERT_COOLDOWN_MINUTES=
# TTL кэша expired-статусов, сек (НЕ связан с REALERT_COOLDOWN_MINUTES выше) —
# только чтобы не бить по API BetBoom повторно за один и тот же «хвост».
# Очередь перепроверки (NOTIFY_RETRY_WINDOW_MINUTES) этот кэш всегда обходит.
EXPIRED_CACHE_TTL_SECONDS=
# TTL подписи действия со страницы колеса, сек. Проверка статуса стоит двух
# запросов (страница за action_uid + подписью, затем сам API) — кэш сводит их
# к одному. У подписи срок жизни сутки, поэтому час здесь с запасом.
ACTION_SIGNATURE_TTL_SECONDS=
# Наблюдательный стоп-гвард: столько подряд ответов unknown (проверка статуса
# вообще перестала давать результат) один раз пишутся предупреждением в
# parser.log; сбрасывается любым определённым статусом. Впятеро больше
# проверок подряд без единого active/soon дают второе предупреждение —
# о заглушке, которую по форме ответа не отличить. Статус не подменяется
# ни в том, ни в другом случае; уведомлений в Telegram по ним нет.
BETBOOM_STUB_GUARD_THRESHOLD=
# Раскрытие сокращённых ссылок (vk.cc, clck.ru, bit.ly, tinyurl.com), за
# которыми стримеры прячут колесо. Таймаут одного запроса, сек, и TTL кэша
# раскрытых адресов, сек (цель сокращателя после публикации не меняется).
SHORTENER_RESOLVE_TIMEOUT=
SHORTENER_CACHE_TTL_SECONDS=
# Перебор слагов колёс: адреса у стримера идут серией (zonertg4, zonertg5, …),
# страница существует ещё до того, как стример выложит ссылку, а
# несуществующий слаг отдаёт 404 — так колесо находится без всякого поста.
# Перебор идёт по чужому адресному пространству, поэтому редко и по одному:
# бан по IP заденет весь парсер, а не только сканер. Выключается
# PREDICTIVE_ENABLED=false.
PREDICTIVE_ENABLED=
PREDICTIVE_SCAN_INTERVAL=
PREDICTIVE_REQUEST_DELAY_SECONDS=
PREDICTIVE_LOOKAHEAD=
PREDICTIVE_DAILY_BUDGET=
PREDICTIVE_BLOCK_COOLDOWN_MINUTES=
# Проверять статус колеса перед уведомлением (по умолчанию true). Уведомление
# уходит только при подтверждённом active; expired, soon и unknown молчат, но
# ссылка попадает в очередь перепроверки (NOTIFY_RETRY_WINDOW_MINUTES ниже) и
# уведомление придёт, как только колесо запустится.
PRECHECK_WHEELS=
STALE_COMMAND_SECONDS=
CHANNEL_FAIL_THRESHOLD=
# Уведомление, если страница канала открывается, но постов в ней нет
# N циклов подряд (защита от «тихой» поломки разбора t.me/s).
CHANNEL_EMPTY_THRESHOLD=
ALERT_ON_FIRST_RUN=
# Недоставленные уведомления повторяются, пока находка не старше этого
# окна (мин), но не больше N повторов за цикл.
NOTIFY_RETRY_WINDOW_MINUTES=
NOTIFY_RETRY_MAX_PER_CYCLE=

# Каталог машинного состояния (wheels.db, seen_ids.json, parser.log,
# lock). По умолчанию — data/ рядом с исходниками.
WHEELSPARSER_DATA_DIR=
# Список Telegram-каналов через запятую — только для первого запуска,
# пока нет channels.txt; дальше управляйте файлом или /add, /remove.
# WHEELSPARSER_CHANNELS=channel1,channel2

# Оформление консоли
USE_COLORS=
USE_ICONS=

# --- Twitch ---
# Мониторинг Twitch-чатов (анонимно, токены не нужны). Ловятся только ссылки
# betboom.ru/freestream от стримера/модераторов/VIP/ботов, без ключевых слов.
# TWITCH_ENABLED=true
# Список каналов через запятую — только для первого запуска, пока нет
# twitch_channels.txt; дальше управляйте через файл или /addtwitch, /removetwitch.
# WHEELSPARSER_TWITCH_CHANNELS=streamer1,streamer2
# Боты, чьи ссылки принимаются даже без бейджа модератора.
# TWITCH_BOTS=nightbot,streamelements,moobot,fossabot,wizebot,streamlabs
# Очередь между потоком чтения IRC и обработчиком сообщений со ссылками.
# TWITCH_QUEUE_MAXSIZE=500
# Переподключение, если из IRC не пришло ни байта за это время (сек).
# Twitch шлёт PING каждые ~5 минут, поэтому порог должен быть заметно больше.
# TWITCH_IDLE_TIMEOUT_SECONDS=360
