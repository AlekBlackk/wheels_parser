# Telegram Bot API. Заполните значения перед запуском.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Параметры WheelsParser (пустое значение = значение по умолчанию)
CHECK_INTERVAL=
REQUEST_TIMEOUT=
MESSAGES_PER_CHANNEL=
# Сколько каналов опрашивается одновременно (было — строго по одному).
CHANNEL_FETCH_CONCURRENCY=
MAX_SEEN_PER_CHANNEL=
# Максимум записей истории в wheels.db — старые отбрасываются.
MAX_RESULTS=
WHEELS_WINDOW_MINUTES=
# Период /top (рейтинг каналов по числу колёс) по умолчанию, дней.
TOP_PERIOD_DAYS=
ACTIVE_MAX_AGE_HOURS=
ACTIVE_CHECK_CONCURRENCY=
REALERT_COOLDOWN_MINUTES=
# TTL кэша expired-статусов, сек (НЕ связан с REALERT_COOLDOWN_MINUTES выше) —
# только чтобы не бить по API BetBoom повторно за один и тот же «хвост».
EXPIRED_CACHE_TTL_SECONDS=
PRECHECK_WHEELS=
STALE_COMMAND_SECONDS=
CHANNEL_FAIL_THRESHOLD=
# Уведомление, если страница канала открывается, но постов в ней нет
# N циклов подряд (защита от «тихой» поломки разбора t.me/s).
CHANNEL_EMPTY_THRESHOLD=
ALERT_ON_FIRST_RUN=
# Недоставленные уведомления повторяются, пока находка не старше этого
# окна (мин), но не больше N повторов за цикл.
NOTIFY_RETRY_WINDOW_MINUTES=
NOTIFY_RETRY_MAX_PER_CYCLE=

# Каталог машинного состояния (wheels.db, seen_ids.json, parser.log,
# lock). По умолчанию — data/ рядом с исходниками.
WHEELSPARSER_DATA_DIR=
# Список Telegram-каналов через запятую — только для первого запуска,
# пока нет channels.txt; дальше управляйте файлом или /add, /remove.
# WHEELSPARSER_CHANNELS=channel1,channel2

# Оформление консоли
USE_COLORS=
USE_ICONS=

# --- Twitch ---
# Мониторинг Twitch-чатов (анонимно, токены не нужны). Ловятся только ссылки
# betboom.ru/freestream от стримера/модераторов/VIP/ботов, без ключевых слов.
# TWITCH_ENABLED=true
# Список каналов через запятую — только для первого запуска, пока нет
# twitch_channels.txt; дальше управляйте через файл или /addtwitch, /removetwitch.
# WHEELSPARSER_TWITCH_CHANNELS=streamer1,streamer2
# Боты, чьи ссылки принимаются даже без бейджа модератора.
# TWITCH_BOTS=nightbot,streamelements,moobot,fossabot,wizebot,streamlabs
# Очередь между потоком чтения IRC и обработчиком сообщений со ссылками.
# TWITCH_QUEUE_MAXSIZE=500
# Переподключение, если из IRC не пришло ни байта за это время (сек).
# Twitch шлёт PING каждые ~5 минут, поэтому порог должен быть заметно больше.
# TWITCH_IDLE_TIMEOUT_SECONDS=360
